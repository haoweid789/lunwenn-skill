{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperspine:open-release:platform-receipts:1.0",
  "title": "PaperSpine Open Release Host Platform Receipts",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "ticket_sha256", "platforms"],
  "properties": {
    "contract": {"const": "paperspine.open-release.platform-receipts"},
    "schema_version": {"const": "1.0"},
    "ticket_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "recorded_at", "idempotency_key"],
        "allOf": [{"if": {"properties": {"status": {"enum": ["PUBLISHED", "SUBMITTED_FOR_REVIEW", "DRAFT_CREATED"]}}, "required": ["status"]}, "then": {"anyOf": [{"required": ["public_url"], "properties": {"public_url": {"type": "string", "minLength": 1}}}, {"required": ["doi"], "properties": {"doi": {"type": "string", "minLength": 1}}}, {"required": ["accession"], "properties": {"accession": {"type": "string", "minLength": 1}}}, {"required": ["platform_record_id"], "properties": {"platform_record_id": {"type": "string", "minLength": 1}}}]}}],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PUBLISHED", "SUBMITTED_FOR_REVIEW", "DRAFT_CREATED", "PREPARED_FOR_INSTITUTIONAL_REVIEW", "WAITING_USER", "FAILED", "SKIPPED"]},
          "recorded_at": {"type": "string", "minLength": 1},
          "public_url": {"type": "string"},
          "doi": {"type": "string"},
          "accession": {"type": "string"},
          "platform_record_id": {"type": "string"},
          "error_code": {"type": "string"},
          "message_zh": {"type": "string"},
          "idempotency_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
