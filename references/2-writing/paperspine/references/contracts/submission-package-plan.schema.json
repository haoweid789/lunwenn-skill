{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/submission-package-plan.schema.json",
  "title": "PaperSpine submission package plan",
  "type": "object",
  "required": ["schema_version", "project_root", "target_name", "target_profile_sha256", "compliance_inputs", "author_confirmations", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_root": {"type": "string", "minLength": 1},
    "target_name": {"type": "string", "minLength": 1},
    "target_profile_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "compliance_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscript_path"],
      "properties": {
        "manuscript_path": {"type": "string", "minLength": 1},
        "rendered_pdf_path": {"type": "string", "minLength": 1},
        "bibliography_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "author_confirmations": {"type":"array","items":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string","minLength":1},"status":{"type":"string","minLength":1}}}},
    "items": {"type":"array","minItems":1,"items":{"type":"object","required":["requirement_id","status"],"properties":{"requirement_id":{"type":"string","minLength":1},"status":{"enum":["ready","needs_author","not_applicable"]},"source_path":{"type":"string","minLength":1},"output_name":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"status":{"const":"ready"}},"required":["status"]},"then":{"required":["source_path"]}}]}},
    "forbidden_target_terms": {"type": "array", "items": {"type": "string"}}
  }
}
