{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperspine.local/contracts/skill-discovery-migration-preview.schema.json",
  "title": "PaperSpine Skill discovery migration read-only preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema_version",
    "operation",
    "operation_id",
    "request_sha256",
    "created_at",
    "canonical_skill",
    "skills_roots",
    "archive_root",
    "status",
    "item_count",
    "file_count",
    "total_bytes",
    "items",
    "mutation_performed",
    "external_action_authorized"
  ],
  "properties": {
    "contract": {"const": "paperspine.skill-discovery-migration-preview"},
    "schema_version": {"const": "1.0"},
    "operation": {"const": "preview"},
    "operation_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "canonical_skill": {"const": "paper-spine"},
    "skills_roots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "archive_root": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "noop"]},
    "item_count": {"type": "integer", "minimum": 0},
    "file_count": {"type": "integer", "minimum": 0},
    "total_bytes": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host", "source", "target", "name", "source_relative_path",
          "files", "file_count", "total_bytes", "tree_sha256"
        ],
        "properties": {
          "host": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "source_relative_path": {"type": "string", "minLength": 1},
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "size_bytes", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "size_bytes": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "file_count": {"type": "integer", "minimum": 0},
          "total_bytes": {"type": "integer", "minimum": 0},
          "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "mutation_performed": {"const": false},
    "external_action_authorized": {"const": false}
  }
}
